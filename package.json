{
  "name": "partybeam-game-catalog",
  "version": "0.1.0",
  "private": true,
  "description": "Validation tooling for the official PartyBeam game catalog.",
  "type": "module",
  "scripts": {
    "validate": "node tools/validate-catalog.mjs",
    "validate-package-projection": "node tools/validate-package-projection.mjs",
    "verify-package": "node tools/verify-package-integrity.mjs",
    "prepare-publication": "node tools/prepare-publication.mjs",
    "test": "node tools/validate-fixtures.mjs && node tools/validate-catalog-semantics.mjs && node tools/validate-publication-preparation.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
